# ==============================================================================
# CredVerify - Environment Variables Template
# Copy this file to .env in local environments. NEVER commit actual .env files!
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite requires VITE_ prefix)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_ENV=development
VITE_ENABLE_MOCK_API=true

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Handled by Teammate)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_placeholder_min_32_chars
JWT_EXPIRES_IN=24h

# Azure SQL Database Connection
AZURE_SQL_SERVER=your-sql-server.database.windows.net
AZURE_SQL_DATABASE=credverify_db
AZURE_SQL_USER=your_db_username_placeholder
AZURE_SQL_PASSWORD=your_db_password_placeholder
AZURE_SQL_PORT=1433

# Azure Blob Storage (Document Evidence & Certificate PDFs)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=placeholder;AccountKey=placeholder;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=credential-evidence

# Azure Key Vault (Optional / Cloud Deployment)
AZURE_KEY_VAULT_URL=https://your-key-vault.vault.azure.net/

# Email Notifications (Leave empty to use dev console outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=CredVerify Notifications <no-reply@credverify.edu>
FRONTEND_URL=http://localhost:5173
